# ==========================================================================
#  adcheck —— 训练循环里的梯度流审计
# ==========================================================================
#
# 用法：训练过程中跑 ad_audit()，看有多少权重"没收到梯度"。
#
# 为什么要在**训练过程中**跑，而不是只在开头跑一次：
#   梯度断裂可以是**动态的** —— 1.34 那轮就遇过：relu 在定点下死亡，
#   隐藏层输出全 0，梯度传不回 W1，而梯度检查两边都是 0，
#   **一致，却根本没验证到任何东西**。静态检查抓不到这种情形。
#
# 🔴 本示例自身的一个坑（值得记）：
#   第一版我在每个样本上都 build() 一次，而 build() 里的 ad_wblock()
#   **每次都创建全新权重** —— 等于每步都重新初始化再训一步，
#   跑了 1000 轮结果完全没训练。表现是"审计报了一堆死权重"，
#   很容易误判成梯度有问题，其实是我的训练循环写错了。
#   修法：权重值持久化在 W[] 里，建图时载入、更新后写回。
import "autodiff.mo";

var X0: [4] i64 = 0;
var X1: [4] i64 = 0;
var TG: [4] i64 = 0;
var W:  [17] i64 = 0;      # 8(W1) + 4(B1) + 4(W2) + 1(B2)，持久化

# 建图并前向。权重从 W[] 载入，保证跨样本、跨轮共享。
fn build(s0: i64, s1: i64, tv: i64) -> i64 {
    ad_reset();
    let x: i64 = ad_block(2);
    ad_set(x, s0);
    ad_set(x + 1, s1);
    let W1: i64 = ad_wblock(8);
    let B1: i64 = ad_wblock(4);
    let W2: i64 = ad_wblock(4);
    let B2: i64 = ad_wblock(1);
    let t: i64 = ad_block(1);
    ad_set(t, tv);
    # 载入持久权重（槽 2..18 连续）
    let i: i64 = 0;
    while i < 17 { ad_set(2 + i, W[i]); i = i + 1; }
    let z1: i64 = ad_matmul(W1, x, 4, 2);
    let h: i64 = ad_vsig(ad_vadd(z1, B1, 4), 4);
    let z2: i64 = ad_matmul(W2, h, 1, 4);
    let y: i64 = ad_vsig(ad_vadd(z2, B2, 1), 1);
    let L: i64 = ad_mse_half(y, t, 1);
    return L;
}

fn save_w() -> i64 {
    let i: i64 = 0;
    while i < 17 { W[i] = ad_val(2 + i); i = i + 1; }
    return 0;
}

# 🔴 为什么不能用大初始化（这是审计抓出来的，不是猜的）：
#   第一版用 ±1.5~6.0 量级初始化，审计稳定报 6 个权重"从未收到过非零
#   梯度" —— 对应 4 个隐藏单元里的 2 个，从初始化那一刻起就是死的。
#   原因：定点 sigmoid 的导数在 |z| 稍大时查表即为 0，于是 dz1=0，
#   该行 W1 与对应 B1 的梯度恒为 0。网络只靠另外 2 个单元就把 XOR
#   解出来了，所以**结果完全正常** —— 不审计根本看不出一半容量是废的。
#   这与 1.34 那轮"relu 在定点下死亡"是同一类问题：定点的饱和区
#   比浮点窄得多，浮点里还能流动的梯度，在定点里已经归零了。

fn main() -> i64 {
    X0[0] = 0;     X1[0] = 0;     TG[0] = 0;
    X0[1] = 0;     X1[1] = 65536; TG[1] = 65536;
    X0[2] = 65536; X1[2] = 0;     TG[2] = 65536;
    X0[3] = 65536; X1[3] = 65536; TG[3] = 0;
    # 固定初始化（可复现）
    # 初始化刻意取**小值**（±0.5 量级）—— 见下方"为什么不能用大初始化"
    W[0] = 32768;    W[1] = 0 - 32768;  W[2] = 26214;   W[3] = 19660;
    W[4] = 19660;    W[5] = 0 - 26214;  W[6] = 29491;   W[7] = 22937;
    W[8] = 0;        W[9] = 0;          W[10] = 0;      W[11] = 0;
    W[12] = 32768;   W[13] = 0 - 16384; W[14] = 24576;  W[15] = 0 - 32768;
    W[16] = 0;

    let ep: i64 = 0;
    let i: i64 = 0;
    let L: i64 = 0;
    let dead: i64 = 0;
    ad_audit_reset();

    while ep < 600 {
        i = 0;
        while i < 4 {
            L = build(X0[i], X1[i], TG[i]);
            ad_backward(L);
            ad_step(6553);
            save_w();
            i = i + 1;
        }
        if ep == 0 {
            dead = ad_audit();
            print("轮   0 审计问题数: "); print_i64(dead); print("\n");
        }
        if ep == 599 {
            dead = ad_audit();
            print("轮 599 审计问题数: "); print_i64(dead); print("\n");
        }
        ep = ep + 1;
    }

    print("\n=== 训练结果（期望 0/1/1/0）===\n");
    i = 0;
    while i < 4 {
        L = build(X0[i], X1[i], TG[i]);
        print("  (");
        print_i64(X0[i] / 65536); print(","); print_i64(X1[i] / 65536);
        print(") -> "); print_i64(ad_val(19) * 100 / 65536);
        print("   期望 "); print_i64(TG[i] / 65536); print("\n");
        i = i + 1;
    }
    return 0;
}
