# uninorm —— Unicode 规范化 NFC / NFD（UAX #15）
#
# ── 概念 ────────────────────────────────────────────────────────────
#   Unicode 标准的「规范等价」：两个字符序列若规范等价，就应当被一视同仁
#   —— 显示、比较、检索都该给同一个结果。U+00C5（Å）与 U+0041 U+030A
#   （A + 上圆环）是同一个字符的两种写法，字节不同、语义相同。
#   UAX #15 定义了四条规范化形式：
#     NFD  规范分解   —— 把预组合字符拆成基字符 + 组合记号
#     NFC  规范分解后重组 —— 尽量合回预组合形式
#     NFKD / NFKC      —— 同上但用**兼容**分解（本实现不做）
#   NFC 是 Web 与文件系统的通行形式（W3C Character Model、Apple HFS+）。
#
#   为什么算「概念」而不是「工程惯例」：C / C++ 标准库完全没有（只能靠 ICU）；
#   Go 与 Rust 要装第三方（x/text、unicode-normalization）；Java 有
#   java.text.Normalizer、Python 有 unicodedata.normalize，但都绑在运行时
#   自带的完整表上、不可裁剪。可嵌入的纯数据表实现基本是空白。
#
# ── 四条规则（本实现的全部难点）────────────────────────────────────
#   1. 递归分解：U+1E14 → U+0112 U+0300，而 U+0112 → U+0045 U+0304。
#      不递归就得不到 NFD(U+1E14) = 0045 0304 0300。
#   2. 规范排序：每个「基字符 + 后继组合记号」段内按 ccc **稳定**排序。
#      稳定是硬要求 —— 同 ccc 的两个记号不能互换位置。
#   3. 阻挡规则（blocking）：记号 C 若前面存在 ccc(B) >= ccc(C) 的记号 B，
#      则 C **不得**与基字符组合。这是最容易被漏掉、漏了又不报错的一条。
#   4. Hangul 算法化：U+AC00..U+D7A3 的 11172 个音节不进表，按
#      UAX #15 的公式现算 —— 这是 Unicode 里唯一「用算法代替表」的地方。
#
# ── 数据结构：三项打包进一个 i64 ────────────────────────────────────
#     UN_CCC   bit 0..15 lo / bit 16..31 hi / bit 32..39 ccc
#     UN_DEC   bit 0..15 cp / bit 16..31 d0 / bit 32..47 d1（0 = singleton）
#     UN_CMP   bit 0..31 键(d0<<16|d1) / bit 32..47 组合结果
#
# ── 覆盖范围（诚实标注，不假装全 Unicode）───────────────────────────
#     U+0000..U+017F
#     U+0300..U+036F
#     U+0384..U+03FF
#     U+1E00..U+1EFF
#     U+1100..U+11FF
#     U+AC00..U+D7A3
#   **之外一律返回 UN_UNK 并置 -1**，不静默给一个像样的答案。
#   表由 Python 3.10 的 unicodedata（Unicode 13.0.0）导出，见 tools/genunorm.py。

var UN_NC: i64 = 0;      # CCC 区间表项数
var UN_ND: i64 = 0;      # 分解表项数
var UN_NP: i64 = 0;      # 组合表项数
var UN_UNK: i64 = 0;     # 最近一次调用遇到覆盖范围外的码点
var UN_OVF: i64 = 0;     # 缓冲区溢出
var UN_NREC: i64 = 0;    # 递归展开次数（二级及以上分解）
var UN_MAXD: i64 = 0;    # 最大分解深度（1 = 未递归）

var UN_SEG: [12] i64 = 0;
var UN_CCC: [30] i64 = 0;
var UN_DEC: [434] i64 = 0;
var UN_CMP: [429] i64 = 0;

var UN_IN:  [64] i64 = 0;    # 输入码点
var UN_NN: i64 = 0;          # 输入长度
var UN_ST:  [64] i64 = 0;    # 分解用栈
var UN_SF:  [64] i64 = 0;    # 栈元素的分解深度
var UN_SP: i64 = 0;
var UN_M: i64 = 0;           # 全分解结果长度
var UN_D1: [512] i64 = 0;    # 全分解结果（排序前）
var UN_D2: [512] i64 = 0;    # NFD 结果
var UN_OUT: [512] i64 = 0;   # NFC 结果
var UN_LN: i64 = 0;          # NFD 长度
var UN_LC: i64 = 0;          # NFC 长度
var UN_SV: [512] i64 = 0;    # 快照（幂等性测试用）
var UN_SN: i64 = 0;

