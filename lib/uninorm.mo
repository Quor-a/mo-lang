    UN_CMP[427] = 33913578455810;
    UN_CMP[428] = 33917873488642;
    return 0;
}


# ── 覆盖判断 ────────────────────────────────────────────────────────────
fn un_cov(cp: i64) -> i64 {
    let i: i64 = 0;
    let j: i64 = 0;
    while i < 12 {
        j = i + 1;
        if cp >= UN_SEG[i] {
            if cp < UN_SEG[j] { return 1; }
        }
        i = i + 2;
    }
    return 0;
}

# ── 规范组合类。表外一律 0（表只收 ccc != 0 的连续段）─────────────────
fn un_ccc(cp: i64) -> i64 {
    let lo: i64 = 0;
    let hi: i64 = UN_NC - 1;
    let mid: i64 = 0;
    let v: i64 = 0;
    let l: i64 = 0;
    let h: i64 = 0;
    while lo <= hi {
        mid = (lo + hi) / 2;
        v = UN_CCC[mid];
        l = v & 65535;
        h = (v >> 16) & 65535;
        if cp < l { hi = mid - 1; }
        if cp >= l {
            if cp > h { lo = mid + 1; }
        }
        if cp >= l {
            if cp <= h { return (v >> 32) & 255; }
        }
    }
    return 0;
}

# ── 规范分解表查询。返回打包项，无分解返回 -1 ─────────────────────────
fn un_dec_of(cp: i64) -> i64 {
    let lo: i64 = 0;
    let hi: i64 = UN_ND - 1;
    let mid: i64 = 0;
    let v: i64 = 0;
    let k: i64 = 0;
    while lo <= hi {
        mid = (lo + hi) / 2;
        v = UN_DEC[mid];
        k = v & 65535;
        if cp < k { hi = mid - 1; }
        if cp > k { lo = mid + 1; }
        if cp == k { return v; }
    }
    return 0 - 1;
}

# ── 规范组合表查询 ──────────────────────────────────────────────────────
fn un_cmp_of(d0: i64, d1: i64) -> i64 {
    let key: i64 = d0 * 65536 + d1;
    let lo: i64 = 0;
    let hi: i64 = UN_NP - 1;
    let mid: i64 = 0;
    let v: i64 = 0;
    let k: i64 = 0;
    while lo <= hi {
        mid = (lo + hi) / 2;
        v = UN_CMP[mid];
        k = v & 4294967295;
        if key < k { hi = mid - 1; }
        if key > k { lo = mid + 1; }
        if key == k { return (v >> 32) & 65535; }
    }
    return 0 - 1;
}

# ── Hangul 常量（UAX #15 的算法化部分）─────────────────────────────────
#    SBase=44032(0xAC00)  LBase=4352(0x1100)  VBase=4449(0x1161)
#    TBase=4519(0x11A7)   LEnd=4370  VEnd=4469  TEnd=4546
#    NCount=588(21*28)    TCount=28   SCount=11172   SEnd=55203(0xD7A3)
# Hangul 算法化组合（UAX #15）。单独抽出是因为它必须在 ccc==0 的分支里
# 被调用：U+1161(V) 与 U+11A8(T) 的 ccc 都是 **0**，在原实现里被当成
# "新的基字符"直接输出，压根不会去尝试组合 —— 于是 Hangul 音节
# **分解正确、重组失败**（实测 U+AC00 的 NFC 仍是 1100 1161）。
# 不查 UN_CMP 表，避免把相邻的两个普通基字符误组合起来。
fn un_hangul_pair(a: i64, b: i64) -> i64 {
    if a >= 4352 {
        if a <= 4370 {
            if b >= 4449 {
                if b <= 4469 {
                    return 44032 + (a - 4352) * 588 + (b - 4449) * 28;
                }
            }
        }
    }
    if a >= 44032 {
        if a <= 55203 {
            let r: i64 = (a - 44032) % 28;
            if r == 0 {
                if b > 4519 {
                    if b <= 4546 { return a + (b - 4519); }
                }
            }
        }
    }
    return 0 - 1;
}

fn un_comp_pair(a: i64, b: i64) -> i64 {
    # L + V -> LV
    if a >= 4352 {
        if a <= 4370 {
            if b >= 4449 {
                if b <= 4469 {
                    return 44032 + (a - 4352) * 588 + (b - 4449) * 28;
                }
            }
        }
    }
    # LV + T -> LVT（只有 T 无尾、即 (S-SBase)%28==0 的 LV 才能再接 T）
    if a >= 44032 {
        if a <= 55203 {
            let r: i64 = (a - 44032) % 28;
            if r == 0 {
                if b > 4519 {
                    if b <= 4546 { return a + (b - 4519); }
                }
            }
        }
    }
    return un_cmp_of(a, b);
}

# ── 写入全分解结果 ──────────────────────────────────────────────────────
fn un_emit(c: i64) -> i64 {
    if UN_M >= 512 { UN_OVF = 1; return 0 - 1; }
    UN_D1[UN_M] = c;
    UN_M = UN_M + 1;
    return 0;
}

# ── 递归全分解（含 Hangul 算法分解）────────────────────────────────────
fn un_dec_all() -> i64 {
    let i: i64 = 0;
    let cp: i64 = 0;
    let c: i64 = 0;
    let d: i64 = 0;
    let dep: i64 = 0;
    let hang: i64 = 0;
    let sidx: i64 = 0;
    let t: i64 = 0;
    UN_M = 0;
    while i < UN_NN {
        cp = UN_IN[i];
        if un_cov(cp) == 0 { UN_UNK = 1; return 0 - 1; }
        UN_SP = 0;
        UN_ST[0] = cp;
        UN_SF[0] = 0;
        UN_SP = 1;
        while UN_SP > 0 {
            UN_SP = UN_SP - 1;
            c = UN_ST[UN_SP];
            dep = UN_SF[UN_SP];
            hang = 0;
            if c >= 44032 { if c <= 55203 { hang = 1; } }
            if hang == 1 {
                sidx = c - 44032;
                t = 4519 + sidx % 28;
                if un_emit(4352 + sidx / 588) < 0 { return 0 - 1; }
                if un_emit(4449 + (sidx % 588) / 28) < 0 { return 0 - 1; }
                if t != 4519 { if un_emit(t) < 0 { return 0 - 1; } }
            }
            if hang == 0 {
                d = un_dec_of(c);
                if d < 0 {
                    if un_emit(c) < 0 { return 0 - 1; }
                }
                if d >= 0 {
                    if dep >= 1 { UN_NREC = UN_NREC + 1; }
                    if dep + 1 > UN_MAXD { UN_MAXD = dep + 1; }
                    let e0: i64 = (d >> 16) & 65535;
                    let e1: i64 = (d >> 32) & 65535;
                    if e1 != 0 {
                        UN_SF[UN_SP] = dep + 1;
                        UN_ST[UN_SP] = e1;
                        UN_SP = UN_SP + 1;
                    }
                    UN_SF[UN_SP] = dep + 1;
                    UN_ST[UN_SP] = e0;
                    UN_SP = UN_SP + 1;
                }
            }
        }
        i = i + 1;
    }
    return UN_M;
}

# ── 规范排序：每段「基字符 + 组合记号」内按 ccc 稳定插入排序 ───────────
fn un_reorder() -> i64 {
    let n: i64 = UN_M;
    let i: i64 = 0;
    let j: i64 = 0;
    let k: i64 = 0;
    let cj: i64 = 0;
    let ck: i64 = 0;
    let go: i64 = 0;
    while i < n {
        if un_ccc(UN_D1[i]) == 0 {
            j = i + 1;
            while j < n {
                cj = UN_D1[j];
                if un_ccc(cj) == 0 { j = n; }
                if j < n {
                    k = j - 1;
                    # 🔴 本轮修掉的缺陷：原写法用 "k = i" 当"找到了插入位置"
                    #    的退出标志，于是收尾那句 UN_D1[k+1] = cj 永远落到
                    #    **段首 i+1**，把已有的记号覆盖掉。
                    #    实测 U+1E14（Ḕ）的 NFD：应为 0045 0304 0300，
                    #    实得 **0045 0300 0300** —— 0304 被 0300 覆盖。
                    #    不报错、不崩溃，只是结果里少了一个不同的记号。
                    #    这与 lib/ac.mo 本轮修掉的插入排序是**同一个模式**：
                    #    拿循环变量当退出标志，就把索引毁了。
                    #    改用独立的 ins 记录插入点，k 只管往下走。
                    let ins: i64 = i + 1;
                    while k >= i + 1 {
                        ck = UN_D1[k];
                        if un_ccc(ck) <= un_ccc(cj) {
                            ins = k + 1;
                            k = i;
                        }
                        if k >= i + 1 {
                            UN_D1[k + 1] = ck;
                            k = k - 1;
                            ins = k + 1;
                        }
                    }
                    UN_D1[ins] = cj;
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    while i < n {
        UN_D2[i] = UN_D1[i];
        i = i + 1;
    }
    UN_LN = n;
    return n;
}

# ── 规范组合（含阻挡规则）──────────────────────────────────────────────
fn un_compose() -> i64 {
    let n: i64 = UN_LN;
    let i: i64 = 0;
    let o: i64 = 0;
    let last: i64 = 0 - 1;
    let c: i64 = 0;
    let cc: i64 = 0;
    let ok: i64 = 0;
    let comp: i64 = 0;
    while i < n {
        c = UN_D2[i];
        cc = un_ccc(c);
        if cc == 0 {
            let hv: i64 = 0 - 1;
            if last >= 0 { hv = un_hangul_pair(UN_OUT[last], c); }
            if hv >= 0 {
                UN_OUT[last] = hv;
            }
            if hv < 0 {
                UN_OUT[o] = c;
                last = o;
                o = o + 1;
            }
        }
        if cc != 0 {
            ok = 0;
            if last >= 0 {
                if o - 1 == last { ok = 1; }
                if o - 1 > last {
                    if un_ccc(UN_OUT[o - 1]) < cc { ok = 1; }
                }
            }
            if ok == 1 {
                comp = un_comp_pair(UN_OUT[last], c);
                if comp < 0 { ok = 0; }
                if comp >= 0 { UN_OUT[last] = comp; }
            }
            if ok == 0 {
                UN_OUT[o] = c;
                o = o + 1;
            }
        }
        i = i + 1;
    }
    UN_LC = o;
    return o;
}

# ── 对外接口 ────────────────────────────────────────────────────────────
# 输入：UN_IN[0..UN_NN)   输出：UN_D2[0..UN_LN) 为 NFD，UN_OUT[0..UN_LC) 为 NFC
fn un_nfd() -> i64 {
    UN_UNK = 0;
    UN_OVF = 0;
    UN_NREC = 0;
    UN_MAXD = 0;
    let r: i64 = un_dec_all();
    if r < 0 { return 0 - 1; }
    un_reorder();
    return UN_LN;
}

fn un_nfc() -> i64 {
    let r: i64 = un_nfd();
    if r < 0 { return 0 - 1; }
    un_compose();
    return UN_LC;
}

# 把上一轮结果喂回输入（幂等性测试用）
fn un_from_nfd() -> i64 {
    let i: i64 = 0;
    while i < UN_LN {
        UN_IN[i] = UN_D2[i];
        i = i + 1;
    }
    UN_NN = UN_LN;
    return UN_LN;
}

fn un_from_nfc() -> i64 {
    let i: i64 = 0;
    while i < UN_LC {
        UN_IN[i] = UN_OUT[i];
        i = i + 1;
    }
    UN_NN = UN_LC;
    return UN_LC;
}

# 快照与比对
fn un_snap_nfd() -> i64 {
    let i: i64 = 0;
    while i < UN_LN {
        UN_SV[i] = UN_D2[i];
        i = i + 1;
    }
    UN_SN = UN_LN;
    return UN_SN;
}

fn un_snap_nfc() -> i64 {
    let i: i64 = 0;
    while i < UN_LC {
        UN_SV[i] = UN_OUT[i];
        i = i + 1;
    }
    UN_SN = UN_LC;
    return UN_SN;
}

fn un_cmp_nfd() -> i64 {
    if UN_LN != UN_SN { return 0; }
    let i: i64 = 0;
    while i < UN_LN {
        if UN_D2[i] != UN_SV[i] { return 0; }
        i = i + 1;
    }
    return 1;
}

fn un_cmp_nfc() -> i64 {
    if UN_LC != UN_SN { return 0; }
    let i: i64 = 0;
    while i < UN_LC {
        if UN_OUT[i] != UN_SV[i] { return 0; }
        i = i + 1;
    }
    return 1;
}

