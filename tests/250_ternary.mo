# expect: 32
# 三元运算符 cond ? a : b（v1.1069）：右结合、嵌套、函数分支、
# 括号后接运算（折叠陷阱已防）。
# t1+t2+t3+t4 = 10+3+12+7 = 32
fn f(x: i64) -> i64 { return x * 2; }
fn main() -> i64 {
    let a: i64 = 4;
    let t1: i64 = a > 3 ? 10 : 20;          # 10
    let t2: i64 = a > 5 ? 1 : a > 4 ? 2 : 3; # 嵌套: a>5 假 → a>4 假 → 3
    let t3: i64 = a < 10 ? f(6) : 0;         # 12
    let t4: i64 = (a == 4 ? 1 : 2) * 7;      # 7
    return t1 + t2 + t3 + t4;                # 10+3+12+7=32
}
