# 101 —— lib/uic.mo 字符画布库
# 用画布原语绘制一个简单窗口，验证库可编译可运行。
# 期望退出码 0。
import "uic.mo";

fn main() -> i64 {
    uc_init(40, 10);
    uc_clear(UC_WHITE, UC_BLUE);
    uc_rect(0, 0, 40, 10, '+', UC_CYAN, UC_BLUE);
    uc_text(2, 1, "Hello Canvas", UC_YELLOW, UC_BLUE);
    uc_fill(1, 3, 20, 1, '=', UC_GREEN, UC_WHITE);
    uc_hline(1, 30, 5, '-', UC_RED, UC_WHITE);
    uc_vline(35, 1, 8, '|', UC_RED, UC_WHITE);
    uc_line(1, 1, 10, 5, '*', UC_RED, UC_BLUE);
    uc_circle(20, 5, 3, 'O', UC_YELLOW, UC_BLUE);
    uc_tri(30, 1, 35, 5, 25, 5, '#', UC_GREEN, UC_BLUE);
    uc_sprite(2, 7, ".##.,#..#,####", UC_MAGENTA, UC_BLUE);
    uc_window(3, 12, 20, 6, " 窗口 ", UC_CYAN, UC_WHITE);
    uc_panel(30, 12, 20, 6, " 面板 ", UC_GREEN, UC_BLUE);
    uc_gauge(3, 19, 16, 60, UC_GREEN, UC_BLUE);
    uc_scrollbar(55, 12, 8, 40, 2, UC_YELLOW, UC_BLUE);
    uc_dump_text();
    uc_dump_file("/tmp/uic_dump_test.txt");
    uc_dump_html("/tmp/uic_dump_test.html");
    uc_layout_h(2, 21, 3, 8, 1, UC_GREEN, UC_BLUE);
    uc_layout_v(40, 20, 2, 3, 1, UC_YELLOW, UC_BLUE);
    uc_label(2, 23, "ON", UC_GREEN, UC_BLUE, 1);
    uc_chart(10, 24, "3,5,2", 4, UC_CYAN, UC_BLUE);
    uc_checkbox(20, 23, "记住", 1, UC_WHITE, UC_BLUE);
    uc_radio(30, 23, "A", 1, UC_WHITE, UC_BLUE);
    uc_input(2, 25, "admin", 8, UC_BLACK, UC_WHITE);
    uc_slider(20, 25, 14, 60, UC_YELLOW, UC_BLUE);
    uc_theme_dark();
    uc_apply_theme();
    uc_icon_check(2, 1, UC_GREEN, UC_BLUE);
    uc_icon_heart(8, 1, UC_RED, UC_BLUE);
    uc_icon_warn(14, 1, UC_YELLOW, UC_BLUE);
    uc_clear(196, 236);
    uc_text(2, 2, "256color", 196, 236);
    uc_text(2, 4, "Bold", UC_WHITE, UC_BLUE);
    uc_style_text(2, 4, "Bold", 1);
    uc_fill_circle(30, 3, 2, '#', UC_YELLOW, UC_BLUE);
    uc_polygon("5,8,7,4", "8,4,7,8", 4, '*', UC_GREEN, UC_BLUE);
    uc_progress_anim(20, 6, 16, 65, UC_GREEN, UC_BLUE);
    uc_digit2(20, 8, 12, UC_YELLOW, UC_BLUE);
    uc_text(5, 2, "MoveMe", UC_YELLOW, UC_BLUE);
    uc_scroll(1, 1, 32, UC_WHITE, UC_BLUE);
    uc_copy(5, 2, 4, 1);
    uc_paste(15, 2);
    uc_text(5, 3, "AB", UC_YELLOW, UC_BLUE);
    uc_flip_h();
    uc_round_rect(2, 5, 10, 3, UC_CYAN, UC_BLUE);
    uc_fill_round(16, 5, 8, 3, '=', UC_GREEN, UC_BLUE);
    uc_axis(5, 8, 12, 5, UC_CYAN, UC_BLUE);
    uc_grid(2, 2, 4, 2, 2, '.', UC_GREEN, UC_BLUE);
    uc_gradient(20, 5, 8, 4, UC_GREEN, UC_BLUE);
    uc_marquee(2, 8, "Hello", 8, 2, UC_YELLOW, UC_BLUE);
    uc_diamond(12, 4, 3, 2, '#', UC_CYAN, UC_BLUE);
    uc_draw_sprite(24, 3, " * ***", 3, 2, UC_MAGENTA, UC_BLUE);
    uc_text(3, 1, "S1", UC_YELLOW, UC_BLUE);
    uc_save_scene();
    uc_text(3, 1, "S2", UC_GREEN, UC_BLUE);
    uc_load_scene();
    uc_border(14, 1, 8, 3, 2, UC_GREEN, UC_BLUE);
    uc_text(20, 3, "Hi", UC_WHITE, UC_BLUE);
    uc_reverse(20, 3, 2, 1);
    uc_button(1, 2, 8, "OK", UC_CYAN, UC_BLUE, 0);
    uc_button(12, 2, 10, "Cancel", UC_GREEN, UC_BLUE, 1);
    uc_spinner(20, 2, 0, UC_GREEN, UC_BLUE);
    uc_spinner(21, 2, 1, UC_GREEN, UC_BLUE);
    uc_text_shadow(5, 2, "T", UC_YELLOW, UC_BLACK, UC_BLUE);
    uc_text_center(6, 2, 8, "Hi", UC_GREEN, UC_BLUE);
    uc_text(2, 3, "MV", UC_YELLOW, UC_BLUE);
    uc_move_window(2, 3, 2, 1, 20, 3, 32, UC_WHITE, UC_BLUE);
    uc_menu_bar(1, 2, 20, "File Edit View", 1, UC_WHITE, UC_BLUE);
    uc_badge(15, 2, "tests", "249", UC_CYAN, UC_GREEN, UC_BLUE);
    uc_tooltip(3, 2, "Tip", UC_YELLOW, UC_BLUE, UC_CYAN);
    uc_signal(6, 2, 3, 5, UC_GREEN, UC_BLUE);
    uc_status_bar(1, 2, 20, "Mo OS", 4, 5, 67, UC_WHITE, UC_BLUE);
    uc_thermo(3, 2, 3, 60, UC_GREEN, UC_BLUE);
    uc_listbox(14, 2, 8, "A|B|C", 1, UC_WHITE, UC_BLUE);
    uc_clock_face(2, 2, 3, 3, 30, UC_GREEN, UC_BLUE);
    uc_face(8, 2, 0, UC_GREEN, UC_BLUE);
    uc_tabs(14, 2, "A|B|C", 1, UC_WHITE, UC_BLUE);
    uc_tree(2, 2, "src|  a.mo|README", UC_GREEN, UC_BLUE);
    uc_table(1, 2, 5, "A|B", "x|1;y|2", UC_WHITE, UC_BLUE);
    uc_breadcrumb(1, 2, "A|B|C", 2, UC_WHITE, UC_BLUE);
    uc_stars(12, 2, 4, 5, UC_GREEN, UC_BLUE);
    uc_toggle(1, 2, 1, UC_GREEN, UC_BLUE);
    uc_dropdown(8, 2, 5, "Hello", UC_GREEN, UC_BLUE);
    uc_dump_svg("/tmp/uic_dump_test.svg");
    uc_render();
    return 0;
}