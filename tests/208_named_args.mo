# expect: 93
# 命名实参 f(b: 2)（v1.1039）：按形参顺序，跳过的形参须有默认值。
# g(3)=35, g(3,4)=34, f(b:2)=127 → 35+34+127000=127069 mod 256 = 93
fn f(a: i64 = 1, b: i64 = 5, c: i64 = 7) -> i64 { return a * 100 + b * 10 + c; }

fn g(a: i64, b: i64 = 5) -> i64 { return a * 10 + b; }

fn main() -> i64 {
    return g(3) + g(3, 4) + f(b: 2) * 1000;
}
