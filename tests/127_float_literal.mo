# 126 —— 浮点字面量的精度
#
# 🔴 这是本轮修掉的核心缺陷：编译器解析浮点字面量只取 **8 位小数**。
#    0.693147180559945 被读成 0.69314718 —— 差 5,043,536 个 ulp，
#    而 0.301029995663981 差 102,033,210 个 ulp。
#    最危险的地方是它**不报错、不崩溃**，只是静默给一个看起来合理的数。
#
# 判据是与 IEEE754 正确舍入值**逐位比对**（fbits 取位模式），
# 而不是"打印出来看起来对"—— 打印只显示 6 位小数，1e8 ulp 的误差看不见。
import "assert.mo";

fn main() -> i64 {
    # ---- 常用常量：必须与正确舍入值逐位相等 ----
    assert_eq("0.1", fbits(0.1), 0x3fb999999999999a);
    assert_eq("0.5", fbits(0.5), 0x3fe0000000000000);
    assert_eq("1.0", fbits(1.0), 0x3ff0000000000000);
    assert_eq("0.0", fbits(0.0), 0x0000000000000000);
    assert_eq("3.141592653589793", fbits(3.141592653589793), 0x400921fb54442d18);
    assert_eq("2.718281828459045", fbits(2.718281828459045), 0x4005bf0a8b145769);
    assert_eq("1.5707963267948966", fbits(1.5707963267948966), 0x3ff921fb54442d18);
    assert_eq("0.693147180559945", fbits(0.693147180559945), 0x3fe62e42fefa39ec);
    assert_eq("0.301029995663981", fbits(0.301029995663981), 0x3fd34413509f79fb);
    assert_eq("123.456", fbits(123.456), 0x405edd2f1a9fbe77);
    assert_eq("1.4142135623730951", fbits(1.4142135623730951), 0x3ff6a09e667f3bcd);
    assert_eq("0.0072973525693", fbits(0.0072973525693), 0x3f7de3d42a1ed29d);
    assert_eq("299792458.0", fbits(299792458.0), 0x41b1de784a000000);
    assert_eq("1.602176634", fbits(1.602176634), 0x3ff9a283f7572034);
    assert_eq("6.02214076", fbits(6.02214076), 0x401816ac11406f31);
    assert_eq("0.000000000000000001", fbits(0.000000000000000001), 0x3c32725dd1d243ac);
    assert_eq("0.00000000000000000000000001", fbits(0.00000000000000000000000001), 0x3a88c240c4aecb14);
    assert_eq("123456789012345678.0", fbits(123456789012345678.0), 0x437b69b4ba630f35);
    assert_eq("99999999999999999.0", fbits(99999999999999999.0), 0x4376345785d8a000);

    # ---- 回归：整数部分不能被截断 ----
    #
    # 🔴 修这个 bug 时我自己引入过一个更严重的：给整数部分也加了 18 位上限，
    #    于是 `9223372036854775807`（19 位）被读成 922337203685477580。
    #    自举立刻报不一致才抓到 —— 因为汇编 seed 的词法器是另一套实现，没跟着截。
    #    而 `0 - 9223372036854775807 - 1` 正是墨语言写 i64::MIN 的惯用法。
    assert_eq("i64::MAX 字面量", 9223372036854775807, 0x7fffffffffffffff);
    assert_eq("i64::MIN 惯用法", 0 - 9223372036854775807 - 1, 0x8000000000000000);
    # 两个 19 位整数若被截成 18 位就相等了 —— 这条能抓到"整数部分被截断"
    assert_eq("整数不受影响", to_i(9223372036854775807 > 9223372036854775806), 1);

    # ---- 已知限制（显式钉住，不是"碰巧通过"）----
    # 量级 < 1e-26 时无法表示（5^k 放不进 i64），返回 0.0。
    assert_eq("1e-27 -> 0（已知限制）", fbits(0.000000000000000000000000001), 0);

    return test_done();
}