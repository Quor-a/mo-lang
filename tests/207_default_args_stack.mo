# expect: 197
# 测试：默认参数 >6 个（栈参数路径，v1.1038）
# 1+4+9+16+25+36+490+640 = 1221 mod 256 = 197
fn f(a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64 = 70, a8: i64 = 80) -> i64 {
    return a1 + a2*2 + a3*3 + a4*4 + a5*5 + a6*6 + a7*7 + a8*8;
}

fn main() -> i64 {
    return f(1, 2, 3, 4, 5, 6);
}
