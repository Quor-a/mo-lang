# expect: 79
# 命名实参·前向调用（v1.1040）：调用点在定义前，形参名由 predeclare 抄录，
# 跳过形参的默认值经 DFP 占位在编译尾回填。
# f(b:2)=127, f(a:3,c:4)=354 → 127 + 354*1000 = 354127 mod 256 = 79
fn main() -> i64 {
    return f(b: 2) + f(a: 3, c: 4) * 1000;
}

fn f(a: i64 = 1, b: i64 = 5, c: i64 = 7) -> i64 {
    return a * 100 + b * 10 + c;
}
