# expect: 39
# 任意维嵌套数组字面量（v1.1066）：[[1,2],[3,4]] / [[[...]],[...]]
# 递归下降铺平行主展开；行数/元素数不符报错；const/负数元素。
# 5+10+1+5+3+7+8 = 39
const K: i64 = 5;
fn main() -> i64 {
    let a: [2][2] i64 = [[K, -2], [3, K * 2]];
    let b: [2][2][2] i64 = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]];
    let d: [3] i64 = [1, -2, 3];
    return a[0][0] + a[1][1] + b[0][0][0] + b[1][0][0] + b[0][1][0] + b[1][1][0] + b[1][1][1];
}
