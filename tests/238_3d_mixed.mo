# expect: 107
# 任意维数组（v1.1058）：二维回归 + 三维 byte + 二维 struct 字段访问 + 全局三维。
# 7 + 60 + 30 + 10 = 107
struct P { x: i64; y: i64; }
var g: [2][2][2] i64;
fn main() -> i64 {
    let a: [2][3] i64;
    a[1][2] = 7;
    let b: [2][2][2] byte;
    b[1][1][0] = 60;
    let c: [2][2] P;
    c[1][0].x = 30;
    g[1][0][1] = 10;
    return a[1][2] + b[1][1][0] + c[1][0].x + g[1][0][1];
}
