# expect: 101
# 逻辑复合赋值 &&= ||＝（v1.1072）：布尔化结果（0/1），左值简单变量。
fn main() -> i64 {
    let a: i64 = 0;
    a ||= 5;      # 0||5 → 1
    let b: i64 = 3;
    b &&= 0;      # 3&&0 → 0
    let c: i64 = 7;
    c &&= 2;      # 7&&2 → 1
    let d: i64 = 0;
    d ||= 0;      # 0||0 → 0
    return a + b * 10 + c * 100 + d * 1000;   # 1+0+100+0 = 101
}
